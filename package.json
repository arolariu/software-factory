{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.22.3",
    "npm": "12.2.3"
  },
  "packageManager": "npm@12.2.3",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-artifacts.mjs",
    "check": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.web.json",
    "test": "vitest run",
    "test:browser": "playwright test",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@fastify/static": "10.1.12",
    "better-sqlite3": "13.2.0",
    "fastify": "5.12.8"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
